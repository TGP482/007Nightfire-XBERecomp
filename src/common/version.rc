#include "build_info.h"

1 VERSIONINFO
FILEOS 0x40004
FILETYPE 0x1
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "007: Nightfire - XBE Recomp"
            VALUE "ProductName", "007: Nightfire - XBE Recomp"
            VALUE "ProductVersion", NIGHTFIRE_COMMIT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
